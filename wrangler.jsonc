// Generated from platforms/cloudflare/wrangler.jsonc in https://github.com/phibkro/file-transfer; change settings in "vars" or the dashboard.
{
  "main": "worker.js",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "name": "file-transfer",
  "no_bundle": true,
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "no_web_socket_compression"
  ],
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomObject"
      },
      {
        "name": "ADMISSION",
        "class_name": "AdmissionObject"
      },
      {
        "name": "COUNTER_STORE",
        "class_name": "CountersObject"
      },
      {
        "name": "RELAY_BUDGET",
        "class_name": "RelayBudgetObject"
      },
      {
        "name": "ADDRESS_SALT_STORE",
        "class_name": "AddressSaltObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RoomObject"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "AdmissionObject"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "CountersObject"
      ]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": [
        "RelayBudgetObject"
      ]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": [
        "AddressSaltObject"
      ]
    }
  ],
  "vars": {
    "LIMIT_ROOMS_PER_ADDRESS_PER_HOUR": "50",
    "LIMIT_RELAYED_BYTES_PER_ROOM": "25000000000",
    "LIMIT_RELAYED_BYTES_PER_DAY": "100000000000",
    "CLIENT_ADDRESS_HEADER": "cf-connecting-ip",
    "DIRECT_CONNECTIONS": "on",
    "STUN_URLS": "stun:stun.cloudflare.com:3478",
    "COUNTERS": "off",
    "COUNTERS_RETENTION_DAYS": "90"
  }
}
