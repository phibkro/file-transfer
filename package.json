{
  "name": "file-transfer",
  "private": true,
  "workspaces": [
    "libraries/*",
    "services/*",
    "platforms/*",
    "integrations/*",
    "apps/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "test": "vp test run",
    "check:graph": "ox-dep-lint",
    "check:dependencies": "knip --treat-config-hints-as-errors",
    "check:effect": "effx check",
    "check:secrets": "gitleaks git --redact --config .gitleaks.toml",
    "check": "vp check --deny-warnings && bun run check:graph && bun run check:dependencies && bun run check:effect && vp test run",
    "check:vectors": "python3 -I libraries/parcel/test/vectors/verify.py",
    "check:changesets": "bun tools/quality/src/checkChangesets.ts",
    "release:prepare": "bun tools/quality/src/prepareRelease.ts",
    "release:notes": "bun tools/quality/src/releaseNotesFor.ts",
    "docs:machines": "bun tools/quality/src/writeStateMachines.ts"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@effect/tsgo": "0.48.0",
    "@phibkro/oxlint-effect-plugin": "0.2.0",
    "@types/bun": "latest",
    "fast-check": "^4.0.0",
    "knip": "6.43.0",
    "ox-dep-lint": "0.2.0",
    "oxlint": "1.86.0",
    "typescript": "7.0.2",
    "ultracite": "8.1.0",
    "vite-plus": "1.4.0"
  },
  "patchedDependencies": {
    "@alchemy.run/cloudflare@2.0.0-beta.84": "patches/@alchemy.run%2Fcloudflare@2.0.0-beta.84.patch"
  }
}
