{
  "name": "file-transfer",
  "private": true,
  "workspaces": [
    "libraries/*",
    "services/*",
    "platforms/*",
    "integrations/*",
    "apps/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "test": "vp test run",
    "check:graph": "bun tools/quality/src/checkModuleGraph.ts",
    "check:effect": "effx check",
    "check:secrets": "gitleaks git --redact --config .gitleaks.toml",
    "check": "vp check --deny-warnings && bun run check:graph && bun run check:effect && vp test run",
    "check:vectors": "python3 -I libraries/parcel/test/vectors/verify.py",
    "check:changesets": "bun tools/quality/src/checkChangesets.ts",
    "release:prepare": "bun tools/quality/src/prepareRelease.ts"
  },
  "dependencies": {
    "effect": "^4.0.7"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@effect/tsgo": "0.48.0",
    "@phibkro/oxlint-effect-plugin": "0.2.0",
    "@types/bun": "latest",
    "fast-check": "^4.0.0",
    "oxlint": "1.86.0",
    "typescript": "7.0.2",
    "ultracite": "8.1.0",
    "vite-plus": "1.4.0"
  },
  "patchedDependencies": {
    "alchemy@2.0.0-beta.83": "patches/alchemy@2.0.0-beta.83.patch"
  }
}
