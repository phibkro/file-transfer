{
  "name": "file-transfer",
  "private": true,
  "workspaces": [
    "libraries/*",
    "services/*",
    "platforms/*",
    "integrations/*",
    "apps/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "test": "vp test run",
    "check:graph": "bun tools/quality/src/checkModuleGraph.ts",
    "check:effect": "effx check",
    "check:secrets": "gitleaks git --redact --config .gitleaks.toml",
    "check": "vp check && bun run check:graph && bun run check:effect && vp test run"
  },
  "dependencies": {
    "effect": "^4.0.7"
  },
  "devDependencies": {
    "@effect/tsgo": "0.48.0",
    "@phibkro/oxlint-effect-plugin": "0.2.0",
    "@types/bun": "latest",
    "fast-check": "^4.0.0",
    "oxlint": "1.86.0",
    "typescript": "7.0.2",
    "vite-plus": "1.4.0"
  }
}
