{
  // The production Worker: room creation and sockets under /api, apps/web from static assets everywhere else.
  // `bun run build` bundles src/worker.ts with esbuild into dist/worker.js; wrangler serves it unbundled.
  "name": "file-transfer",
  "main": "dist/worker.js",
  "no_bundle": true,
  "compatibility_date": "2026-10-01",
  // Spike 0001: per-message deflate cost 8.7x relay throughput, and parcel records are ciphertext that does not compress.
  "compatibility_flags": ["no_web_socket_compression"],
  // Off: the server never sees keys or file names, but request logs would keep room identifiers and timing.
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomObject" },
      // One per client key (a salted hash of an address): counts room creations per hour (src/admissionObject.ts).
      { "name": "ADMISSION", "class_name": "AdmissionObject" },
      // One per instance: opt-in aggregate counters (src/countersObject.ts), empty unless COUNTERS is "on".
      { "name": "COUNTER_STORE", "class_name": "CountersObject" },
      // One per instance: bytes relayed today, against LIMIT_RELAYED_BYTES_PER_DAY (src/relayBudgetObject.ts).
      { "name": "RELAY_BUDGET", "class_name": "RelayBudgetObject" },
      // One per instance: the random salt for address hashes, generated on first use (src/addressSaltObject.ts).
      { "name": "ADDRESS_SALT_STORE", "class_name": "AddressSaltObject" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomObject"] },
    { "tag": "v2", "new_sqlite_classes": ["AdmissionObject"] },
    { "tag": "v3", "new_sqlite_classes": ["CountersObject"] },
    { "tag": "v4", "new_sqlite_classes": ["RelayBudgetObject"] },
    { "tag": "v5", "new_sqlite_classes": ["AddressSaltObject"] },
  ],
  // The operator's limits (src/limits.ts, docs/decisions/0019-open-source-first.md). Change them here, in the
  // Cloudflare dashboard, or at deploy time. The salt for address hashes is generated on first use; set ADDRESS_SALT
  // as a secret only to choose it yourself.
  "vars": {
    "LIMIT_ROOMS_PER_ADDRESS_PER_HOUR": "50",
    "LIMIT_RELAYED_BYTES_PER_ROOM": "25000000000",
    // 100 GB a day for the whole instance, below the about 125 GB that Workers Free's 100,000 daily Durable Object
    // requests carry (docs/spikes/0003). On Workers Paid, raise it or set "off".
    "LIMIT_RELAYED_BYTES_PER_DAY": "100000000000",
    "CLIENT_ADDRESS_HEADER": "cf-connecting-ip",
    // Direct paths between browsers (src/directSettings.ts): "off" keeps every transfer on the relay. STUN tells each
    // browser its public address; Cloudflare's STUN service is free.
    "DIRECT_CONNECTIONS": "on",
    "STUN_URLS": "stun:stun.cloudflare.com:3478",
    // Aggregate counters are off unless the operator opts in with "on". Read them at /api/admin/counters and
    // /api/admin/metrics with `wrangler secret put ADMIN_TOKEN` set.
    "COUNTERS": "off",
    "COUNTERS_RETENTION_DAYS": "90",
  },
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
}
