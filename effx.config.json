{
  "effect": {
    "strictness": "strict",
    "trustedPureDependencies": [
      {
        "specifier": "vite-plus/test",
        "reason": "Vitest through Vite+; tools/quality rejects it in shipped files, so only the test role reaches it"
      },
      {
        "specifier": "fast-check",
        "reason": "pure property-testing library; tools/quality rejects it in shipped files"
      },
      {
        "specifier": "@file-transfer/conformance",
        "reason": "workspace test-support package; Bun links it through node_modules, so the gate sees a package; tools/quality checks the edge"
      },
      {
        "specifier": "@file-transfer/conformance/guarantee",
        "reason": "workspace package of plain guarantee declarations, governed by its own group below; tools/quality checks the edge"
      },
      {
        "specifier": "valibot",
        "reason": "pure schema validation for wire contracts the browser decodes (docs/decisions/0020); no I/O, no eval"
      },
      {
        "specifier": "@file-transfer/parcel",
        "reason": "workspace package governed by its own group below; tools/quality checks the edge"
      },
      {
        "specifier": "@file-transfer/transport",
        "reason": "workspace package governed by its own group below; tools/quality checks the edge"
      },
      {
        "specifier": "@file-transfer/transport/protocol",
        "reason": "the transport package's protocol entry, without Effect, for the browser (docs/decisions/0020); tools/quality checks the edge"
      },
      {
        "specifier": "@file-transfer/service-telemetry",
        "reason": "workspace service package; the platform imports its pure event kinds and buckets, governed by the services group; tools/quality checks the edge"
      },
      {
        "specifier": "@file-transfer/service-room",
        "reason": "workspace service package; tools/quality reads its machine table to generate docs/state-machines.md, and the services group governs it; tools/quality checks the edge"
      },
      {
        "specifier": "@file-transfer/service-relay",
        "reason": "workspace service package; tools/quality reads its machine table to generate docs/state-machines.md, and the services group governs it; tools/quality checks the edge"
      },
      {
        "specifier": "@file-transfer/machine",
        "reason": "workspace package governed by its own group below; tools/quality checks the edge"
      },
      {
        "specifier": "@file-transfer/web/recipientPhase",
        "reason": "the web app's recipient table, a pure-library file; tools/quality reads it to generate docs/state-machines.md; tools/quality checks the edge"
      }
    ],
    "groups": [
      {
        "files": [
          "libraries/client/src/**",
          "libraries/machine/src/**",
          "libraries/sink/src/**",
          "libraries/transport/src/**",
          "libraries/conformance/src/guarantee.ts",
          "platforms/cloudflare/src/room.ts",
          "platforms/cloudflare/src/limits.ts",
          "platforms/cloudflare/src/counters.ts",
          "platforms/cloudflare/src/relayBudget.ts",
          "platforms/cloudflare/src/salt.ts"
        ],
        "role": "effect-library",
        "platform": "portable"
      },
      {
        "files": [
          "libraries/parcel/src/**",
          "tools/quality/src/moduleGraph.ts",
          "tools/quality/src/changesets.ts",
          "tools/quality/src/releaseNotes.ts",
          "tools/quality/src/stateMachines.ts",
          "tools/quality/src/lockfile.ts",
          "platforms/self-hosted/src/assetRouting.ts",
          "platforms/cloudflare/src/durableObjectCalls.ts",
          "platforms/cloudflare/src/directSettings.ts"
        ],
        "role": "pure-library",
        "platform": "portable"
      },
      {
        "files": ["services/*/src/**"],
        "role": "service",
        "platform": "portable"
      },
      {
        "files": ["tools/quality/src/workspace.ts", "tools/quality/src/repository.ts"],
        "role": "runtime-adapter",
        "platform": "node",
        "adapterDependencies": ["node:fs", "node:path", "node:child_process", "oxc-parser"]
      },
      {
        "files": [
          "tools/quality/src/checkModuleGraph.ts",
          "tools/quality/src/checkChangesets.ts",
          "tools/quality/src/prepareRelease.ts",
          "tools/quality/src/releaseNotesFor.ts",
          "tools/quality/src/writeStateMachines.ts"
        ],
        "role": "composition-root",
        "platform": "node"
      },
      {
        "files": [
          "apps/web/src/files.ts",
          "apps/web/src/ranges.ts",
          "apps/web/src/credits.ts",
          "apps/web/src/selection.ts",
          "apps/web/src/sniff.ts",
          "apps/web/src/recipientPhase.ts",
          "apps/web/scripts/faultPlan.ts"
        ],
        "role": "pure-library",
        "platform": "portable"
      },
      {
        "files": [
          "apps/web/src/address.ts",
          "apps/web/src/connection.ts",
          "apps/web/src/storage.ts",
          "apps/web/src/report.ts",
          "apps/web/src/view.ts",
          "apps/web/src/sender.ts",
          "apps/web/src/recipient.ts",
          "apps/web/src/share.ts",
          "apps/web/src/summary.ts",
          "apps/web/src/saveAll.ts",
          "apps/web/src/leaveGuard.ts",
          "apps/web/src/storagePanel.ts",
          "apps/web/src/preview.ts",
          "apps/web/src/previewFrame.ts",
          "apps/web/src/rename.ts",
          "apps/web/src/serverLimits.ts",
          "apps/web/src/admin.ts",
          "apps/web/src/direct.ts",
          "apps/web/src/directSettings.ts"
        ],
        "role": "runtime-adapter",
        "platform": "browser",
        "adapterDependencies": ["uqr", "uplot", "valibot"]
      },
      {
        "files": ["apps/web/src/main.ts"],
        "role": "composition-root",
        "platform": "browser"
      },
      {
        "files": [
          "libraries/conformance/src/index.ts",
          "libraries/*/test/**",
          "services/*/test/**",
          "platforms/*/test/**",
          "integrations/*/test/**",
          "apps/*/test/**",
          "tools/*/test/**"
        ],
        "role": "test",
        "platform": "node"
      }
    ]
  },
  "oxlintConfig": "oxlint.config.ts",
  "tsconfig": "tsconfig.json"
}
